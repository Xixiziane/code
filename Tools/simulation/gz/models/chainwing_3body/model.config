<?xml version="1.0"?>
<model>
  <name>chainwing_3body</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>
  <author>
    <name>Chain-Wing UAV Team</name>
  </author>
  <description>
    Chain-wing UAV 3-body model: three fixed-wing units linked at wingtips
    by high-stiffness revolute joints (simulating semi-rigid hinge connection).

    Based on chainwing single-body model with identical aerodynamics.
    - Single unit: 1.9 kg, 1.2 m span, 0.3 m chord
    - Combined: 5.7 kg, 3.6 m span
    - Hinge: revolute joint, stiffness=500 N·m/rad, damping=50 N·m·s/rad
    - Slave elevator used for coplanar position trim

    For slave controller firmware development and testing.
  </description>
</model>
