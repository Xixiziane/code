<?xml version="1.0"?>
<model>
  <name>chainwing</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Chain-Wing UAV Team</name>
  </author>

  <description>
    Chain-wing UAV: three fixed-wing units linked at wingtips.
    Based on MATLAB open-loop dynamics validation data:
    - Single unit: 1.9 kg, 1.2 m span, 0.3 m chord
    - Combined: 5.7 kg, 3.6 m span
    - Cruise: 20 m/s, T_max=15 N/motor
    Three motors for differential thrust yaw control.
    Reversed elevon allocation for roll stability.
  </description>
</model>
