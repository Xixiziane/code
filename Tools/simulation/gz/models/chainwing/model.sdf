<?xml version="1.0"?>
<!--
  Chain-Wing UAV (3-unit) Gazebo model
  Three fixed-wing units linked at wingtips forming a large aspect ratio wing.

  Based on report data:
  - Single unit: mass 0.5 kg, wingspan 0.6 m, chord 0.18 m
  - Three-unit combined: total mass ~1.5 kg, total wingspan ~1.8 m
  - Cruise speed: ~12 m/s, stall: ~6 m/s
  - Trim angle of attack: 4.5 deg
  - NACA 5412 wing airfoil, NACA 0010 tail airfoil

  Actuator mapping (matching 2150_chainwing airframe):
    Motor 0 (ESC1): left unit pusher    - command/motor_speed motorNumber=0
    Motor 1 (ESC2): center unit pusher  - command/motor_speed motorNumber=1
    Motor 2 (ESC3): right unit pusher   - command/motor_speed motorNumber=2
    Servo 0 (SV1):  left unit elevon    - servo_0 (right elevon type, reversed)
    Servo 1 (SV2):  center elevator     - servo_1
    Servo 2 (SV3):  right unit elevon   - servo_2 (left elevon type, reversed)
-->
<sdf version='1.9'>
  <model name='chainwing'>
    <pose>0 0 0.15 0 0 0</pose>

    <!-- ==================== MAIN BODY (center unit fuselage) ==================== -->
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.04 0 0 0 0 0</pose>
        <!-- Combined 3-unit mass: 3 × 0.5 kg = 1.5 kg -->
        <mass>1.5</mass>
        <inertia>
          <!-- Ixx: large due to wide wingspan (1.8m span) -->
          <ixx>0.40</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <!-- Iyy: pitch inertia (fuselage length dominated) -->
          <iyy>0.06</iyy>
          <iyz>0</iyz>
          <!-- Izz: very large yaw inertia (key chain-wing characteristic) -->
          <izz>0.45</izz>
        </inertia>
      </inertial>

      <!-- Center fuselage collision -->
      <collision name='center_fuselage_collision'>
        <pose>-0.10 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.67 0.08 0.10</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>10</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Combined wing collision (3 units × 0.6m span = 1.8m) -->
      <collision name='wing_collision'>
        <pose>-0.01 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 1.80 0.02</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>10</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Center fuselage visual -->
      <visual name='center_fuselage_visual'>
        <pose>-0.10 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.67 0.08 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>

      <!-- Left fuselage visual -->
      <visual name='left_fuselage_visual'>
        <pose>-0.10 -0.60 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.67 0.08 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.6 1.0</ambient>
          <diffuse>0.4 0.4 0.6 1.0</diffuse>
        </material>
      </visual>

      <!-- Right fuselage visual -->
      <visual name='right_fuselage_visual'>
        <pose>-0.10 0.60 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.67 0.08 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.6 1.0</ambient>
          <diffuse>0.4 0.4 0.6 1.0</diffuse>
        </material>
      </visual>

      <!-- Left wing section (left unit: Y = -0.30 to -0.90) -->
      <visual name='left_wing_visual'>
        <pose>-0.01 -0.60 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.60 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 1.0</ambient>
          <diffuse>0.8 0.8 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Center wing section (center unit: Y = -0.30 to +0.30) -->
      <visual name='center_wing_visual'>
        <pose>-0.01 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.60 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.3 1.0</ambient>
          <diffuse>0.9 0.9 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- Right wing section (right unit: Y = +0.30 to +0.90) -->
      <visual name='right_wing_visual'>
        <pose>-0.01 0.60 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.60 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 1.0</ambient>
          <diffuse>0.8 0.8 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Horizontal tail (center unit) -->
      <visual name='htail_visual'>
        <pose>-0.50 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.40 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1.0</ambient>
          <diffuse>0.6 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Vertical tail (center unit) -->
      <visual name='vtail_visual'>
        <pose>-0.50 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.008 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1.0</ambient>
          <diffuse>0.6 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Left unit vertical tail -->
      <visual name='vtail_left_visual'>
        <pose>-0.50 -0.60 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.008 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1.0</ambient>
          <diffuse>0.6 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Right unit vertical tail -->
      <visual name='vtail_right_visual'>
        <pose>-0.50 0.60 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.008 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1.0</ambient>
          <diffuse>0.6 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Wingtip connection markers (Y = ±0.30) -->
      <visual name='left_connection_visual'>
        <pose>-0.01 -0.30 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.02 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
        </material>
      </visual>
      <visual name='right_connection_visual'>
        <pose>-0.01 0.30 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.02 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
        </material>
      </visual>

      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
      </sensor>

      <!-- Air pressure sensor -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
    </link>

    <!-- ==================== AIRSPEED SENSOR ==================== -->
    <link name="airspeed">
      <pose>0.15 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="airspeed_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1.0</ambient>
          <diffuse>0 0 0 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='airspeed_joint' type='fixed'>
      <child>airspeed</child>
      <parent>base_link</parent>
    </joint>

    <!-- ==================== LANDING GEAR ==================== -->
    <link name="LeftWheel">
      <pose relative_to="LeftWheelJoint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="LeftWheelVisual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
      </visual>
      <collision name="LeftWheelCollision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="RightWheel">
      <pose relative_to="RightWheelJoint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="RightWheelVisual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
      </visual>
      <collision name="RightWheelCollision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="NoseWheel">
      <pose relative_to="NoseWheelJoint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="NoseWheelVisual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.025</radius>
          </cylinder>
        </geometry>
      </visual>
      <collision name="NoseWheelCollision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.025</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="LeftWheelJoint" type="revolute">
      <parent>base_link</parent>
      <child>LeftWheel</child>
      <pose relative_to="base_link">-0.04 -0.30 -0.12 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="RightWheelJoint" type="revolute">
      <parent>base_link</parent>
      <child>RightWheel</child>
      <pose relative_to="base_link">-0.04 0.30 -0.12 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="NoseWheelJoint" type="revolute">
      <parent>base_link</parent>
      <child>NoseWheel</child>
      <pose relative_to="base_link">0.20 0 -0.12 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== PROPELLERS ==================== -->
    <!-- Motor 0: Left unit pusher (Y = -0.6m) -->
    <link name='rotor_left'>
      <pose>0.22 -0.60 0.0 0 1.5708 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name='rotor_left_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://rc_cessna/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1 1.0</ambient>
          <diffuse>0 0 1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='rotor_left_joint' type='revolute'>
      <child>rotor_left</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Motor 1: Center unit pusher (Y = 0.0m) -->
    <link name='rotor_center'>
      <pose>0.22 0.0 0.0 0 1.5708 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name='rotor_center_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://rc_cessna/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 1 0 1.0</ambient>
          <diffuse>0 1 0 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='rotor_center_joint' type='revolute'>
      <child>rotor_center</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Motor 2: Right unit pusher (Y = +0.6m) -->
    <link name='rotor_right'>
      <pose>0.22 0.60 0.0 0 1.5708 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name='rotor_right_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://rc_cessna/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 0 0 1.0</ambient>
          <diffuse>1 0 0 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='rotor_right_joint' type='revolute'>
      <child>rotor_right</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== CONTROL SURFACES ==================== -->
    <!-- Servo 0: Left unit elevon (right elevon type - reversed for chain-wing) -->
    <link name="left_elevon">
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
        <pose>0 -0.60 0 0 0 0</pose>
      </inertial>
      <visual name='left_elevon_visual'>
        <pose>-0.44 -0.60 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.30 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1.0</ambient>
          <diffuse>0 0 1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='servo_0' type='revolute'>
      <parent>base_link</parent>
      <child>left_elevon</child>
      <pose>-0.44 -0.60 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.53</lower>
          <upper>0.53</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>

    <!-- Servo 1: Center unit elevator -->
    <link name="elevator">
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
        <pose>-0.50 0 0 0 0 0</pose>
      </inertial>
      <visual name='elevator_visual'>
        <pose>-0.50 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.36 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0 1 0 1.0</ambient>
          <diffuse>0 1 0 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='servo_1' type='revolute'>
      <parent>base_link</parent>
      <child>elevator</child>
      <pose>-0.50 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.53</lower>
          <upper>0.53</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>

    <!-- Servo 2: Right unit elevon (left elevon type - reversed for chain-wing) -->
    <link name="right_elevon">
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
        <pose>0 0.60 0 0 0 0</pose>
      </inertial>
      <visual name='right_elevon_visual'>
        <pose>-0.44 0.60 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.30 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1.0</ambient>
          <diffuse>1 0 0 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name='servo_2' type='revolute'>
      <parent>base_link</parent>
      <child>right_elevon</child>
      <pose>-0.44 0.60 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.53</lower>
          <upper>0.53</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>

    <!-- ==================== LIFT/DRAG PLUGINS ==================== -->
    <!--
      Aerodynamic parameters based on report:
      - Wing airfoil: NACA 5412
      - CL_alpha ~ 4.75 /rad (from XFLR5 analysis)
      - CD_0 ~ 0.02, CD_alpha ~ 0.64
      - alpha_stall ~ 13 deg = 0.227 rad
      - CL_max ~ 1.48
      - Zero-lift alpha (a0) ~ 0.05 rad (5412 has positive camber)
      - Wing area per section: chord(0.18) × half-span(0.30) = 0.054 m²
    -->

    <!-- Left wing section with left elevon control -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.07</a0>
      <cla>4.75</cla>
      <cda>0.64</cda>
      <cma>0.0</cma>
      <alpha_stall>0.227</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.92</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.04 -0.60 0.02</cp>
      <area>0.108</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>servo_0</control_joint_name>
      <control_joint_rad_to_cl>-0.3</control_joint_rad_to_cl>
    </plugin>

    <!-- Center wing section (no aileron control, elevator only for pitch) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.07</a0>
      <cla>4.75</cla>
      <cda>0.64</cda>
      <cma>0.0</cma>
      <alpha_stall>0.227</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.92</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.04 0 0.02</cp>
      <area>0.108</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
    </plugin>

    <!-- Right wing section with right elevon control -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.07</a0>
      <cla>4.75</cla>
      <cda>0.64</cda>
      <cma>0.0</cma>
      <alpha_stall>0.227</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.92</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.04 0.60 0.02</cp>
      <area>0.108</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>servo_2</control_joint_name>
      <control_joint_rad_to_cl>-0.3</control_joint_rad_to_cl>
    </plugin>

    <!-- Horizontal tail with elevator control -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.2</a0>
      <cla>4.75</cla>
      <cda>0.64</cda>
      <cma>0.0</cma>
      <alpha_stall>0.34</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.92</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.50 0 0</cp>
      <area>0.050</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>servo_1</control_joint_name>
      <control_joint_rad_to_cl>-4.0</control_joint_rad_to_cl>
    </plugin>

    <!-- ==================== SERVO POSITION CONTROLLERS ==================== -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_0</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>10.0</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_1</joint_name>
      <sub_topic>servo_1</sub_topic>
      <p_gain>10.0</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_2</joint_name>
      <sub_topic>servo_2</sub_topic>
      <p_gain>10.0</p_gain>
    </plugin>

    <!-- ==================== MOTOR PLUGINS ==================== -->
    <!-- Motor 0: Left unit (CW rotation) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_left_joint</jointName>
      <linkName>rotor_left</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>2.45e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Motor 1: Center unit (CCW rotation) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_center_joint</jointName>
      <linkName>rotor_center</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>2.45e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Motor 2: Right unit (CW rotation) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_right_joint</jointName>
      <linkName>rotor_right</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>2.45e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <static>0</static>
  </model>
</sdf>
